---
import 'pretendard-jp/dist/web/variable/pretendardvariable-jp-dynamic-subset.css';
import '../styles/global.css';
import LoginControl from '../components/LoginControl.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { aboutLinkFor } from '../lib/about';
import { href } from '../lib/posts';
import { ui } from '../lib/ui';

interface Props {
  title: string;
  lang?: string;
  crumbs?: { label: string; href?: string }[];
}

const { title, lang = 'ko', crumbs = [] } = Astro.props;
const t = ui(lang);
const aboutLink = await aboutLinkFor(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <nav aria-label={t.site}>
          <a class="site-name" href={href('/')}>blog</a>
          <a class="nav-link" href={href('/posts/')}>{t.posts}</a>
          <a class="nav-link" href={aboutLink}>{t.about}</a>
        </nav>
        <div class="header-actions">
          <button id="search-open" class="icon-button" type="button" aria-label={t.search} aria-keyshortcuts="Control+K Meta+K">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
          </button>
          <button id="theme-toggle" class="icon-button" type="button" aria-label={t.theme}>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
            </svg>
          </button>
          <LoginControl lang={lang} />
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      {
        crumbs.length > 0 && (
          <div class="crumbs">
            <a class="back" href={crumbs.findLast((c) => c.href)?.href ?? href('/')}>
              <span aria-hidden="true">←</span> {t.back}
            </a>
            <nav aria-label={t.crumbs}>
              <ol>
                {[{ label: t.home, href: href('/') }, ...crumbs].map((c) => (
                  <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
                ))}
              </ol>
            </nav>
          </div>
        )
      }
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">© juhyeonni</div>
    </footer>
    <SearchDialog lang={lang} />
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var root = document.documentElement;
        var current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
